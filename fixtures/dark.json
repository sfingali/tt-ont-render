  "events": [
    {
      "id": "e_accident",
      "type": "ordinary",
      "label": "Origin-world bridge accident kills Tannhaus family",
      "description": "In the world beneath all the others, a bridge collapse kills H.G. Tannhaus's son, daughter-in-law and granddaughter - a grief he cannot live with.",
      "at": {
        "worldRef": "w_origin",
        "timeLabel": "origin night"
      },
      "agents": [
        "origin_family",
        "tannhaus"
      ]
    },
    {
      "id": "e_machine",
      "type": "bootstrap_origin",
      "label": "Tannhaus builds time machine → creates knot worlds",
      "description": "Tannhaus builds a machine to bring his family back - and instead tears open the passages that create the two knotted worlds of Winden entirely.",
      "at": {
        "worldRef": "w_origin",
        "timeLabel": "grief machine"
      },
      "agents": [
        "tannhaus"
      ],
      "payload": {
        "bootstrapEntity": "knot_worlds",
        "artifactKind": "device"
      }
    },
    {
      "id": "e_cave",
      "type": "departure",
      "label": "Cave passages link 33-year eras",
      "description": "Beneath Winden, the caves link three eras - 1953, 1986, 2019 - thirty-three years apart, and anything that walks in comes out in another time.",
      "at": {
        "worldRef": "w_adam",
        "timeLabel": "2019 cave"
      },
      "agents": [
        "jonas"
      ],
      "payload": {
        "travelMode": "cave_portal",
        "travelDelta": "±33y"
      }
    },
    {
      "id": "e_mikkel",
      "type": "arrival",
      "label": "Mikkel stranded 1986 → Michael",
      "description": "A boy, Mikkel, walks into the caves in 2019 and steps out in 1986, where he is raised by strangers and grows up as Michael Kahnwald - Jonas's father.",
      "at": {
        "worldRef": "w_adam",
        "timeLabel": "1986"
      },
      "agents": [
        "mikkel"
      ],
      "payload": {
        "travelMode": "cave_portal",
        "bootstrapEntity": "jonas_father",
        "note": "Jonas's father is Jonas's brother"
      }
    },
    {
      "id": "e_sic_mundus",
      "type": "ordinary",
      "label": "Sic Mundus / Erit Lux sustain loops",
      "description": "A secret society, Sic Mundus, works across the centuries to keep the knot of Winden's history exactly as it is - or, some say, to undo it.",
      "at": {
        "worldRef": "w_adam",
        "timeLabel": "multi-era"
      },
      "agents": [
        "noah",
        "claudia",
        "jonas"
      ]
    },
    {
      "id": "e_book",
