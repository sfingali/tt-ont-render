  "events": [
    {
      "id": "e_radio",
      "type": "ordinary",
      "label": "Radio Hall / Kurisu stab vision",
      "description": "Okabe and friends attend a time-machine lecture; when he later returns to the hall he finds a pool of blood and Kurisu seemingly stabbed - and sends a frantic text about it.",
      "at": {
        "worldRef": "w_alpha",
        "timeLabel": "July 28"
      },
      "agents": [
        "okabe",
        "kurisu"
      ]
    },
    {
      "id": "e_dmail0",
      "type": "departure",
      "label": "First D-mail to past phone",
      "description": "The 'phone microwave' they built as a joke sent that text into the past - the first D-mail - and when Okabe returns to the hall, the blood is gone and Kurisu is alive.",
      "at": {
        "worldRef": "w_alpha",
        "timeLabel": "lab"
      },
      "agents": [
        "okabe",
        "daru"
      ],
      "payload": {
        "travelMode": "other",
        "worldlineId": "alpha",
        "divergenceMagnitude": 0
      }
    },
    {
      "id": "e_shift_alpha",
      "type": "branch_fork",
      "label": "Worldline shifts into Alpha attractor",
      "description": "The message changed more than the scene: the world has quietly slipped onto a different track of history, its grain now running a different way.",
      "at": {
        "worldRef": "w_alpha",
        "timeLabel": "post D-mail"
      },
      "agents": [
        "okabe"
      ],
      "payload": {
        "worldlineId": "alpha",
        "attractorFieldId": "alpha",
        "readingSteiner": true,
        "divergenceMagnitude": 0.5
      }
    },
    {
      "id": "e_mayuri_deaths",
      "type": "death",
      "label": "Mayuri dies repeatedly under Alpha attractor",
      "description": "On this track of history, Okabe's childhood friend Mayuri keeps dying - no matter what he fixes, the world finds a way, and each death rewinds him to find out it will happen again.",
      "at": {
        "worldRef": "w_alpha",
        "timeLabel": "many iterations"
      },
      "agents": [
        "mayuri",
        "okabe"
      ],
      "payload": {
        "attractorFieldId": "alpha",
        "iteration": 1
      }
    },
    {
      "id": "e_undo_dmails",
      "type": "intervention",
      "label": "Undo D-mails (Faris, Luka, etc.)",
      "description": "Okabe works out the chain: each message moved the world onto a different track, so he must undo them one by one - Faris's, Luka's, Suzuha's - to get back.",
      "at": {
        "worldRef": "w_alpha",
        "timeLabel": "undo arc"
      },
      "agents": [
        "okabe",
        "faris",
        "luka",
        "kurisu"
      ],
      "payload": {
        "readingSteiner": true
      }
    },
    {
      "id": "e_sern",
      "type": "observation",
      "label": "SERN / dystopia future revealed",
      "description": "Beneath it all lies the reason the path must change: this history ends in SERN's dystopia - a future where the company that cracked time rules a broken world.",
      "at": {
        "worldRef": "w_alpha",
        "timeLabel": "Alpha future"
      },
      "agents": [
        "suzuha",
        "okabe"
      ]
    },
    {
      "id": "e_to_beta",
      "type": "branch_fork",
      "label": "Cross to Beta: Mayuri lives, Kurisu dies",
      "description": "Undoing the last message takes Okabe to the Beta track: Mayuri lives - but on Beta, Kurisu's death is the fixed point.",
      "at": {
        "worldRef": "w_beta",
        "timeLabel": "divergence ~1%"
      },
      "agents": [
        "okabe"
      ],
      "payload": {
        "worldlineId": "beta",
        "attractorFieldId": "beta",
        "readingSteiner": true,
        "divergenceMagnitude": 1
      }
    },
    {
      "id": "e_kurisu_dead",
      "type": "death",
      "label": "Kurisu death fixed on Beta",
      "description": "The cruel bargain of Beta: to save Mayuri, Okabe must leave the woman he loves dead in the pool of blood where he first found her.",
      "at": {
        "worldRef": "w_beta",
        "timeLabel": "Radio Hall Beta"
      },
      "agents": [
        "kurisu"
      ],
      "payload": {
        "attractorFieldId": "beta"
      }
    },
    {
      "id": "e_time_leap",
      "type": "departure",
      "label": "Time leap machine iterations",
      "description": "Suzuha brings the time-leap machine - a way to send memory upstream - and Okabe uses it to test, again and again, whether Kurisu's death can ever be avoided.",
      "at": {
        "worldRef": "w_beta",
        "timeLabel": "lab leaps"
      },
      "agents": [
        "okabe",
        "kurisu"
      ],
      "payload": {
        "travelMode": "machine",
        "memoryRetained": true
      }
    },
    {
      "id": "e_suzuha_cg",
      "type": "arrival",
      "label": "Suzuha from CG future / WWIII warning",
      "description": "Suzuha Amane travelled from 2036: her future is the third world war, triggered by the time-travel arms race that grew out of Beta.",
      "at": {
        "worldRef": "w_beta",
        "timeLabel": "Beta future link"
      },
      "agents": [
        "suzuha"
      ],
      "payload": {
        "travelMode": "machine",
        "worldlineId": "beta"
      }
    },
    {
      "id": "e_video",
      "type": "bootstrap_origin",
      "label": "Okabe's video d-mail plan (Reading Steiner cue)",
      "description": "The plan that resolves it: a video message sent to Okabe's own past self, convincing him he saw Kurisu die - a lie to make the past hold its shape.",
      "at": {
        "worldRef": "w_beta",
        "timeLabel": "video message"
      },
      "agents": [
        "okabe"
      ],
      "payload": {
        "bootstrapEntity": "deceive_worldline",
        "readingSteiner": true,
        "observerContinuity": true
      }
    },
    {
      "id": "e_fake_stab",
      "type": "intervention",
      "label": "Fake Kurisu death; deceive Okabe past",
      "description": "The deception staged in blood and acting: past Okabe must believe Kurisu is dead, while the real one lives on hidden from both him and SERN.",
      "at": {
        "worldRef": "w_beta",
        "timeLabel": "Radio Hall op"
      },
      "agents": [
        "okabe",
        "kurisu",
        "suzuha"
      ],
      "payload": {
        "attractorFieldId": "steins_gate"
      }
    },
    {
      "id": "e_steins",
      "type": "branch_fork",
      "label": "Reach Steins Gate worldline",
      "description": "Past the fixed points of both histories lies a third grain - the Steins Gate line - where neither Mayuri nor Kurisu is fated to die, and SERN never rises.",
