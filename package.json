{
  "name": "tt-ont-render",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Authored, human-readable guides to stories that bend time, with an optional legacy ontology viewer.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "tsx tests/run.ts && tsx --test tests/reader.test.ts tests/flowchart.test.ts",
    "typecheck": "tsc --noEmit",
    "render": "tsx src/cli.ts",
    "coverage": "tsx src/coverage-cli.ts",
    "build:web": "node web/build.mjs",
    "serve:web": "node web/build.mjs && npx --yes http-server web/dist -p 8099 -c-1",
    "build:release": "node web/build.mjs --release"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2",
    "esbuild": "^0.25.0"
  }
}
